root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{csproj,props,targets,sln,lvlib,lvproj}]
indent_style = tab
end_of_line = crlf

[*.{md,json,yml,yaml,py}]
indent_style = space
indent_size = 2
end_of_line = lf
